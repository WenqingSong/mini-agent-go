# 复制为 .env 后填写真实值（make init 会做这一步，且不会覆盖已存在的 .env）。
# .env 已被 .gitignore 忽略，永远不要提交或打进镜像。
# 值不需要加引号（引号会被当成值的一部分）；值可以包含空格，但不能跨行。

# ---- 必填：Provider 配置（变量名与 cmd/mini-agent/main.go 的 loadConfig 一致）----
# OpenAI 兼容服务的根地址；客户端固定请求 <BaseURL>/chat/completions，可自带 /v1 前缀。
MINI_AGENT_LLM_BASE_URL=https://llm.example.invalid/v1
MINI_AGENT_MODEL=REPLACE_WITH_MODEL_NAME
MINI_AGENT_LLM_API_KEY=REPLACE_WITH_LLM_API_KEY

# ---- 必填：本服务对外的 Bearer 凭证 ----
# 容器内监听 0.0.0.0:8080（非回环地址），应用要求必须配置该凭证；
# 宿主机侧只映射到 127.0.0.1，不暴露到局域网。生成示例：openssl rand -hex 32
MINI_AGENT_AUTH_TOKEN=REPLACE_WITH_HTTP_BEARER_TOKEN

# ---- 可选：留空或删除则使用应用默认值 ----
MINI_AGENT_SYSTEM_PROMPT=你是一个简洁的助手。
MINI_AGENT_REQUEST_TIMEOUT=60s
MINI_AGENT_SHUTDOWN_GRACE=10s
MINI_AGENT_MAX_REQUEST_BYTES=1048576
MINI_AGENT_MAX_LLM_CALLS=8
MINI_AGENT_MAX_TOOL_CALLS=8
MINI_AGENT_TOOL_TIMEOUT=30s
