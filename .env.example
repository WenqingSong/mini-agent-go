# mini-agent-go
# 复制为 .env，填写必要凭证即可启动。
# 默认使用作者验收过的腾讯云 TokenHub；也支持其他兼容 OpenAI Chat Completions / Tool Calling 的服务。
# 如需复现作者的 TokenHub 环境，可联系作者获取临时测试 API Key。

# 模型 API 地址（支持根地址或完整 /chat/completions 端点）
MINI_AGENT_LLM_BASE_URL=https://tokenhub.tencentmaas.com/v1

# 模型 ID（更换服务商时同步修改）
MINI_AGENT_MODEL=deepseek/deepseek-flash

# 模型服务 API Key（必填）
MINI_AGENT_LLM_API_KEY=REPLACE_WITH_YOUR_API_KEY

# 本服务 HTTP Bearer Token（必填，可使用 openssl rand -hex 32 生成）
MINI_AGENT_AUTH_TOKEN=REPLACE_WITH_YOUR_HTTP_TOKEN

# Docker 容器内监听地址（配合宿主机 127.0.0.1 端口映射）
MINI_AGENT_LISTEN_ADDR=0.0.0.0:8080























# ------------------------------------------------------------------
# 以下为可选配置，通常无需修改
# ------------------------------------------------------------------

MINI_AGENT_SYSTEM_PROMPT=你是一个简洁的助手。
MINI_AGENT_REQUEST_TIMEOUT=60s
MINI_AGENT_SHUTDOWN_GRACE=10s
MINI_AGENT_MAX_REQUEST_BYTES=1048576

# Agent 执行预算
MINI_AGENT_MAX_LLM_CALLS=8
MINI_AGENT_MAX_TOOL_CALLS=8
MINI_AGENT_TOOL_TIMEOUT=30s

# Context 管理：0 禁用压缩；正整数启用估算预算
MINI_AGENT_CONTEXT_TOKEN_BUDGET=0
MINI_AGENT_CONTEXT_KEEP_RECENT=8

# 前端静态文件目录（Docker 镜像已预设 /app/web）
# MINI_AGENT_WEB_DIR=/app/web